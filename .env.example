# Copia este archivo a .env y rellena los valores. .env nunca se sube al repositorio.
# Sin ninguna variable, Vigía funciona en modo reglas y guarda los correos en outbox/.

# IA (opcional): sin clave, todo se resuelve con reglas
ANTHROPIC_API_KEY=
# Tope de gasto de IA por ejecución, en dólares
AI_BUDGET_USD=0.50
# 0 = forzar el modo reglas aunque haya clave
VIGIA_USE_AI=1

# Correo real (opcional): SIEMPRE se redirige al buzón de prueba DEMO_RECIPIENT
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DEMO_RECIPIENT=

# ERP de demo (API para el asistente de WhatsApp). El token, al menos 16 caracteres;
# compártelo en persona, nunca en el repositorio
VIGIA_ERP_DB=data/erp-demo.sqlite
VIGIA_ERP_TOKEN=

# Asistente de WhatsApp (whatsapp-hack/, ADR 008): clave de Zernio y número de la demo (9 cifras)
ZERNIO_API_KEY=
HACK_NUMERO_DEMO=
# Solo si en este equipo hay una instalación de producción del asistente (ver whatsapp-hack/README.md)
HACK_PROTEGER_CLAVES=
HACK_PROTEGER_CICLO=
HACK_PROTEGER_MUTEX=
HACK_PROTEGER_PERFIL=

# Tipo de interés de demora legal vigente (%). Vacío = no se calculan intereses
LATE_INTEREST_RATE_PCT=

# BALTER real (opcional): solo con documentación de su API y visto bueno de la empresa.
# Primera prueba de solo lectura. Ver docs/integracion-balter.md
BALTER_URL=
BALTER_USER=
BALTER_TOKEN=
